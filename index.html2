
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop.ayushacharya</title>
    <link rel="icon" type="image/x-icon" href="https://raw.githubusercontent.com/ayushacharya05/shop/refs/heads/main/images/icon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --brand-primary: #3b82f6;
            --brand-gradient: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            --brand-success: #10b981;
            --brand-danger: #ef4444;
            --fonepay-red: #dc2626;
            --bg-main: #f8fafc;
            --bg-surface: #ffffff;
            --text-heading: #0f172a;
            --text-body: #475569;
            --text-muted: #94a3b8;
            --border-color: #e2e8f0;
            --radius-lg: 16px;
            --radius-md: 12px;
            --radius-sm: 8px;
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
            --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-body);
            padding: 0;
            line-height: 1.6;
        }

        /* Professional Navigation Header */
        .navbar {
            background: var(--bg-surface);
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 2rem;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow-sm);
        }

        .nav-container {
            max-width: 1300px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
            color: var(--text-heading);
            font-weight: 800;
            font-size: 1.3rem;
            letter-spacing: -0.5px;
        }

        .brand-logo i {
            background: var(--brand-gradient);
            color: white;
            padding: 0.5rem;
            border-radius: var(--radius-md);
            font-size: 1.1rem;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        }

        /* Cart Trigger Element */
        .nav-cart-status {
            background: #f1f5f9;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            user-select: none;
            border: 1px solid transparent;
            position: relative;
        }

        .nav-cart-status i {
            color: var(--text-heading);
            font-size: 1.25rem;
            transition: transform 0.2s;
        }

        .nav-cart-status:hover {
            border-color: var(--brand-primary);
            background: #eff6ff;
        }
        
        .nav-cart-status:hover i {
            color: var(--brand-primary);
            transform: scale(1.05);
        }

        .nav-cart-status.has-items {
            background: var(--brand-gradient);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }

        .nav-cart-status.has-items i {
            color: white;
        }

        /* Workspace Grid Layout */
        .main-workspace {
            max-width: 1300px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }

        .store-intro {
            margin-bottom: 2rem;
            text-align: left;
        }

        .store-intro h1 {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text-heading);
            letter-spacing: -0.75px;
            margin-bottom: 0.4rem;
        }

        .store-intro p {
            color: var(--text-body);
            font-size: 1rem;
        }

        .shop-layout-grid {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .catalog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 1.5rem;
        }

        /* Sticky Cart Checkout Panel Layout */
        .checkout-panel-sticky {
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            box-shadow: var(--shadow-md);
            display: flex;
            flex-direction: column;
            opacity: 0;
            transform: translateY(15px);
            transition: opacity 0.4s ease, transform 0.4s ease, border-color 0.3s ease;
            scroll-margin-top: 6rem;
        }

        .checkout-panel-sticky.visible {
            opacity: 1;
            transform: translateY(0);
        }

        @media (max-width: 991px) {
            .shop-layout-grid.has-items {
                display: flex;
                flex-direction: column;
            }
            .checkout-panel-sticky .panel-cart-header,
            .checkout-panel-sticky .cart-items-ledger,
            .checkout-panel-sticky .summary-total-container {
                order: 1;
            }
            .checkout-panel-sticky #store-checkout-form,
            .checkout-panel-sticky .support-help-center {
                order: 3;
            }
            .checkout-panel-sticky::before {
                content: "";
                display: block;
                order: 2;
                margin: 1.5rem -1.5rem;
                border-bottom: 8px solid #f1f5f9;
            }
            
            .shop-layout-grid.has-items #checkout-sidebar-panel {
                order: -1;
                background: transparent;
                border: none;
                box-shadow: none;
                padding: 0;
            }

            .checkout-panel-sticky .panel-cart-header,
            .checkout-panel-sticky .cart-items-ledger,
            .checkout-panel-sticky .summary-total-container {
                background: var(--bg-surface);
                border-left: 1px solid var(--border-color);
                border-right: 1px solid var(--border-color);
                padding-left: 1rem;
                padding-right: 1rem;
            }
            .checkout-panel-sticky .panel-cart-header {
                border-top: 1px solid var(--border-color);
                border-top-left-radius: var(--radius-lg);
                border-top-right-radius: var(--radius-lg);
                padding-top: 1rem;
                margin-bottom: 0;
            }
            .checkout-panel-sticky .summary-total-container {
                border-bottom: 1px solid var(--border-color);
                border-bottom-left-radius: var(--radius-lg);
                border-bottom-right-radius: var(--radius-lg);
                padding-bottom: 1rem;
                margin-bottom: 0;
            }

            .checkout-panel-sticky #store-checkout-form {
                background: var(--bg-surface);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                padding: 1.25rem;
                box-shadow: var(--shadow-sm);
            }
        }

        @media (min-width: 992px) {
            .shop-layout-grid {
                display: grid;
                grid-template-columns: 1fr;
                align-items: start;
                transition: grid-template-columns 0.4s ease;
            }
            .shop-layout-grid.has-items {
                grid-template-columns: 1.4fr 1.1fr;
            }
            .checkout-panel-sticky {
                position: sticky;
                top: 5rem;
            }
        }

        .product-premium-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .product-premium-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: var(--brand-primary);
        }

        .item-meta-header {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 0.85rem;
        }

        .item-meta-header .icon-wrapper {
            background: #eff6ff;
            color: var(--brand-primary);
            font-size: 1.3rem;
            padding: 0.75rem;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .product-premium-card:hover .icon-wrapper {
            background: var(--brand-primary);
            color: white;
        }

        .item-meta-header h3 {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-heading);
            line-height: 1.3;
            margin-top: 0.2rem;
        }

        .product-premium-card .desc {
            color: var(--text-body);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        /* Dynamic Specification Area */
        .dynamic-spec-box {
            background: #fdfdfd;
            border: 1px solid #f1f5f9;
            border-radius: var(--radius-md);
            padding: 0.85rem;
            margin-bottom: 1rem;
            min-height: 150px;
        }

        .dynamic-spec-box h5 {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-bottom: 0.4rem;
        }

        .dynamic-spec-list {
            list-style: none;
        }

        .dynamic-spec-list li {
            font-size: 0.8rem;
            color: var(--text-body);
            margin-bottom: 0.3rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            animation: nodeEntrance 0.2s ease-out;
        }

        .dynamic-spec-list li i {
            color: var(--brand-success);
            font-size: 0.8rem;
        }

        /* Upgraded Continuous Slider Layout Configurations */
        .slider-control-hub {
            background: #f8fafc;
            border: 1px solid var(--border-color);
            padding: 1rem;
            border-radius: var(--radius-md);
            margin-bottom: 1rem;
        }

        .slider-meta-tags {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-body);
            letter-spacing: 0.5px;
            margin-bottom: 0.6rem;
        }

        .tier-label-output {
            color: var(--brand-primary);
            font-weight: 700;
        }

        .custom-range-slider {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 6px;
            border-radius: 10px;
            background: var(--border-color);
            outline: none;
            margin-bottom: 0.6rem;
            cursor: pointer;
        }

        .custom-range-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--brand-primary);
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
            transition: transform 0.1s;
        }

        .custom-range-slider::-webkit-slider-thumb:active {
            transform: scale(1.15);
        }

        .live-pricing-counter {
            text-align: right;
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--text-heading);
        }
        
        .live-pricing-counter span {
            color: var(--brand-primary);
            transition: color 0.2s;
        }

        /* Interactive Add Button */
        .action-add-btn {
            width: 100%;
            background: var(--text-heading);
            color: white;
            border: none;
            padding: 0.8rem;
            border-radius: var(--radius-md);
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .action-add-btn:hover {
            background: var(--brand-primary);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }

        /* Cart Content Ledger Elements */
        .checkout-panel-sticky h2 {
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--text-heading);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 0.75rem;
        }

        .checkout-panel-sticky h2 i {
            color: var(--brand-primary);
        }

        .cart-items-ledger {
            margin-bottom: 1rem;
            max-height: 200px;
            overflow-y: auto;
            padding-right: 0.25rem;
        }

        .ledger-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.6rem 0;
            border-bottom: 1px solid #f1f5f9;
            animation: nodeEntrance 0.25s ease-out forwards;
        }

        .ledger-row-details h4 {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-heading);
            margin-bottom: 0.1rem;
        }

        .ledger-row-details span {
            font-size: 0.8rem;
            color: var(--brand-primary);
            font-weight: 700;
        }

        .ledger-row-delete {
            background: #fff5f5;
            border: none;
            color: var(--brand-danger);
            cursor: pointer;
            font-size: 0.85rem;
            padding: 0.4rem;
            border-radius: var(--radius-sm);
            transition: all 0.2s;
        }

        .ledger-row-delete:hover {
            background: var(--brand-danger);
            color: white;
        }

        .summary-total-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--border-color);
            padding-top: 1rem;
            margin-bottom: 1.25rem;
        }

        .summary-total-container span {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text-body);
        }

        .summary-total-container .price-tag {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-heading);
            letter-spacing: -0.5px;
        }

        /* Checkout Form Configuration */
        .form-row-compact {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
        }

        @media (min-width: 480px) {
            .form-row-compact {
                grid-template-columns: 1fr 1fr;
            }
        }

        .form-control-block {
            margin-bottom: 0.75rem;
        }

        .form-control-block label {
            display: block;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-heading);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.3rem;
        }

        .form-control-block input, .form-control-block textarea {
            width: 100%;
            padding: 0.65rem 0.85rem;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.88rem;
            color: var(--text-heading);
            outline: none;
            background-color: #f8fafc;
            transition: all 0.2s;
        }

        .form-control-block input:focus, .form-control-block textarea:focus {
            border-color: var(--brand-primary);
            background-color: white;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        /* FonePay Exclusive Locked Elements */
        .gateway-exclusive-lock {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid #fee2e2;
            background: #fff5f5;
            color: #991b1b;
            padding: 0.6rem 0.85rem;
            border-radius: var(--radius-md);
            font-weight: 700;
            font-size: 0.85rem;
        }

        .gateway-exclusive-lock i {
            font-size: 1.1rem;
            color: var(--fonepay-red);
        }

        .gateway-instruction-banner {
            background-color: #f8fafc;
            border-left: 3px solid var(--fonepay-red);
            color: var(--text-body);
            padding: 0.5rem 0.75rem;
            border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
            margin-top: 0.4rem;
            font-size: 0.8rem;
            line-height: 1.3;
        }

        .checkout-submit-trigger {
            width: 100%;
            background: var(--brand-gradient);
            color: white;
            border: none;
            padding: 0.9rem;
            font-size: 0.95rem;
            font-weight: 700;
            border-radius: var(--radius-md);
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
            transition: all 0.2s;
            margin-top: 0.5rem;
        }

        .checkout-submit-trigger:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 16px rgba(37, 99, 235, 0.35);
        }

        .checkout-submit-trigger:disabled {
            background: var(--text-muted);
            box-shadow: none;
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
        }

        .support-help-center {
            margin-top: 1.25rem;
            background: #f8fafc;
            border: 1px dashed var(--border-color);
            border-radius: var(--radius-md);
            padding: 0.85rem;
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-body);
            line-height: 1.4;
        }

        .support-help-center a {
            color: var(--brand-primary);
            font-weight: 700;
            text-decoration: none;
            border-bottom: 1px solid rgba(59, 130, 246, 0.2);
        }

        .hidden { display: none !important; }

        @keyframes nodeEntrance {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="nav-container">
            <a href="#" class="brand-logo">
                <i class="fa-solid fa-store"></i>
                <span>shop.ayushacharya</span>
            </a>
            <div class="nav-cart-status" id="nav-cart-trigger" title="View Selected Items">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
        </div>
    </nav>

    <div class="main-workspace">
        <div class="store-intro">
            <h1>Premium Digital Solutions Catalog</h1>
            <p>Drag the sliders smoothly. The plans, prices, and checklist specifications will seamlessly adapt as you change tiers.</p>
        </div>

        <div class="shop-layout-grid" id="main-layout-wrapper">
            <div class="catalog-grid">
                
                <div class="product-premium-card" data-id="web_development" data-name="Website Development">
                    <div>
                        <div class="item-meta-header">
                            <div class="icon-wrapper"><i class="fa-solid fa-code"></i></div>
                            <h3>Web Application Development</h3>
                        </div>
                        <p class="desc">High-performance responsive setups, pristine layout models, interactive dashboard apps, and business-critical portals built to scale.</p>
                        
                        <div class="dynamic-spec-box">
                            <h5>Included Framework Deliverables:</h5>
                            <ul class="dynamic-spec-list" id="webdev-spec-target"></ul>
                        </div>
                    </div>
                    <div>
                        <div class="slider-control-hub">
                            <div class="slider-meta-tags"><span>Plan Tier</span><span class="tier-label-output" id="webdev-tier-txt">Essential Tier</span></div>
                            <input type="range" class="custom-range-slider webdev-step-slider" min="0" max="100" value="0">
                            <div class="live-pricing-counter">Rs. <span id="webdev-price-txt">5,000</span></div>
                        </div>
                        <button type="button" class="action-add-btn"><i class="fa-solid fa-plus"></i> Add to Cart</button>
                    </div>
                </div>

                <div class="product-premium-card" data-id="graphic_design" data-name="Graphic Designing">
                    <div>
                        <div class="item-meta-header">
                            <div class="icon-wrapper"><i class="fa-solid fa-bezier-curve"></i></div>
                            <h3>Creative Graphic Designing</h3>
                        </div>
                        <p class="desc">Bespoke corporate identity solutions, vector UI components, professional brand manuals, production collateral, and typography.</p>
                        
                        <div class="dynamic-spec-box">
                            <h5>Included Design Deliverables:</h5>
                            <ul class="dynamic-spec-list" id="graphic-spec-target"></ul>
                        </div>
                    </div>
                    <div>
                        <div class="slider-control-hub">
                            <div class="slider-meta-tags"><span>Plan Tier</span><span class="tier-label-output" id="graphic-tier-txt">Essential Tier</span></div>
                            <input type="range" class="custom-range-slider graphic-step-slider" min="0" max="100" value="0">
                            <div class="live-pricing-counter">Rs. <span id="graphic-price-txt">1,000</span></div>
                        </div>
                        <button type="button" class="action-add-btn"><i class="fa-solid fa-plus"></i> Add to Cart</button>
                    </div>
                </div>

                <div class="product-premium-card" data-id="digital_marketing" data-name="Digital Marketing">
                    <div>
                        <div class="item-meta-header">
                            <div class="icon-wrapper"><i class="fa-solid fa-chart-line"></i></div>
                            <h3>Growth & Digital Marketing</h3>
                        </div>
                        <p class="desc">Search optimization blueprints, conversion tracking loops, structured paid acquisition structures, and media expansion assets.</p>
                        
                        <div class="dynamic-spec-box">
                            <h5>Included Growth Operations:</h5>
                            <ul class="dynamic-spec-list" id="marketing-spec-target"></ul>
                        </div>
                    </div>
                    <div>
                        <div class="slider-control-hub">
                            <div class="slider-meta-tags"><span>Plan Tier</span><span class="tier-label-output" id="marketing-tier-txt">Essential Tier</span></div>
                            <input type="range" class="custom-range-slider marketing-step-slider" min="0" max="100" value="0">
                            <div class="live-pricing-counter">Rs. <span id="marketing-price-txt">1,500</span></div>
                        </div>
                        <button type="button" class="action-add-btn"><i class="fa-solid fa-plus"></i> Add to Cart</button>
                    </div>
                </div>

                <div class="product-premium-card" data-id="web_hosting" data-name="Premium Web Hosting">
                    <div>
                        <div class="item-meta-header">
                            <div class="icon-wrapper"><i class="fa-solid fa-server"></i></div>
                            <h3>Premium Web Hosting</h3>
                        </div>
                        <p class="desc">High-performance SSD cloud ecosystem optimized directly for swift deployment and loading benchmarks.</p>
                        
                        <div class="dynamic-spec-box">
                            <h5>Included Plan Inclusions:</h5>
                            <ul class="dynamic-spec-list" id="hosting-spec-target"></ul>
                        </div>
                    </div>
                    <div>
                        <div class="slider-control-hub">
                            <div class="slider-meta-tags"><span>Plan Tier</span><span class="tier-label-output" id="hosting-tier-txt">Web Essential</span></div>
                            <input type="range" class="custom-range-slider hosting-step-slider" min="0" max="100" value="0">
                            <div class="live-pricing-counter">Rs. <span id="hosting-price-txt">1,080</span><small style="font-size:0.7rem; color:var(--text-muted); font-weight:500;"> /yr</small></div>
                        </div>
                        <button type="button" class="action-add-btn"><i class="fa-solid fa-plus"></i> Add to Cart</button>
                    </div>
                </div>

                <div class="product-premium-card" data-id="domain_registry" data-name="Domain Registration">
                    <div>
                        <div class="item-meta-header">
                            <div class="icon-wrapper"><i class="fa-solid fa-globe"></i></div>
                            <h3>Domain Registration</h3>
                        </div>
                        <p class="desc">Global premium domain extension indexing with managed nameserver routing control frameworks.</p>
                        
                        <div class="dynamic-spec-box">
                            <h5>Domain Registry Inclusions:</h5>
                            <ul class="dynamic-spec-list" id="domain-spec-target"></ul>
                        </div>
                    </div>
                    <div>
                        <div class="slider-control-hub">
                            <div class="slider-meta-tags"><span>Extension</span><span class="tier-label-output" id="domain-tier-txt">.xyz Extension</span></div>
                            <input type="range" class="custom-range-slider domain-step-slider" min="0" max="100" value="0">
                            <div class="live-pricing-counter">Rs. <span id="domain-price-txt">500</span><small style="font-size:0.7rem; color:var(--text-muted); font-weight:500;"> /yr</small></div>
                        </div>
                        <button type="button" class="action-add-btn"><i class="fa-solid fa-plus"></i> Add to Cart</button>
                    </div>
                </div>

            </div>

            <div class="checkout-panel-sticky hidden" id="checkout-sidebar-panel">
                <div class="panel-cart-header">
                    <h2><i class="fa-solid fa-basket-shopping"></i> Selected Items</h2>
                </div>
                
                <div id="cart-nodes-wrapper" class="cart-items-ledger"></div>

                <div class="summary-total-container">
                    <span>Estimated Investment:</span>
                    <span class="price-tag">Rs. <span id="grand-total-ledger">0</span></span>
                </div>

                <form id="store-checkout-form">
                    <div class="form-row-compact">
                        <div class="form-control-block">
                            <label for="usr-name">Full Name</label>
                            <input type="text" id="usr-name" placeholder="Anjan Acharya" required>
                        </div>
                        <div class="form-control-block">
                            <label for="usr-email">Email Address</label>
                            <input type="email" id="usr-email" placeholder="client@company.com" required>
                        </div>
                    </div>

                    <div class="form-control-block">
                        <label>Verified Checkout Method</label>
                        <div class="gateway-exclusive-lock">
                            <i class="fa-solid fa-qrcode"></i>
                            <span>FonePay Secure QR Portal</span>
                        </div>
                        <div class="gateway-instruction-banner">
                            The FonePay QR will be sent directly to your email after confirmation.
                        </div>
                    </div>

                    <div class="form-control-block">
                        <label for="usr-notes">Project Directives / Special Instructions</label>
                        <textarea id="usr-notes" rows="2" placeholder="Provide extra framework instructions, context descriptions..."></textarea>
                    </div>

                    <button type="submit" id="submit-order-btn" class="checkout-submit-trigger" disabled>Place Order Request</button>
                </form>

                <div class="support-help-center">
                    Need custom specs or custom assistance? <a href="#" id="custom-assistance-link">Click Here</a> to email us directly.
                </div>
            </div>
        </div>
    </div>

    <script>
        let checkoutCartItems = [];
        let currentlyActiveState = {};

        // Data Arrays Mapping Out Sub-Tiers mapping seamlessly into continuous slide logic
        const webdevMatrix = [
            { threshold: 33, label: "Essential Tier", price: 5000, specs: ["Responsive Single Page System", "Clean HTML/CSS layout configuration", "Interactive basic components", "Standard contact form processing pipelines", "Optimized loading speed blueprints"] },
            { threshold: 75, label: "Plus Tier", price: 25000, specs: ["Multi-page standard corporate web structures", "Advanced JavaScript interaction protocols", "Customized CSS/Tailwind frontend layers", "Content management platform adjustments", "API communications system integration"] },
            { threshold: 101, label: "Ultimate Tier", price: 85000, specs: ["Fullstack enterprise software system builds", "Comprehensive admin operations controller panel", "High security custom database configurations", "Robust user login session structures", "Priority 24/7 technical deployment assistance"] }
        ];

        const graphicMatrix = [
            { threshold: 33, label: "Essential Tier", price: 1000, specs: ["1 High-resolution Vector Logotype mock", "Basic typographic layout guides", "Export structures in transparent PNG/SVG formats", "2 standard design revisions cycles"] },
            { threshold: 75, label: "Plus Tier", price: 10000, specs: ["3 alternative conceptual brand logs", "Complete visual standards guidebook asset manual", "Social media production toolkit templates", "High priority support revision windows"] },
            { threshold: 101, label: "Ultimate Tier", price: 25000, specs: ["Complete enterprise level brand makeover systems", "Custom UI/UX component vector library kits", "Print-ready marketing deployment files bundle", "Unlimited design system enhancement iterations"] }
        ];

        const marketingMatrix = [
            { threshold: 33, label: "Essential Tier", price: 1500, specs: ["Initial organic engine visibility audit report", "Basic targeted keyword optimization tracking", "Setup guides for analytics monitoring channels", "Monthly search query ranking updates"] },
            { threshold: 75, label: "Plus Tier", price: 18000, specs: ["Comprehensive technical ranking corrections", "Targeted paid advertising campaign execution outlines", "Continuous conversion path tuning models", "Interactive digital dashboard performance indicators"] },
            { threshold: 101, label: "Ultimate Tier", price: 50000, specs: ["Full channel omnipresent advertising systems", "In-depth competitor structural performance tracking", "Bespoke user retention and copy assets creation", "Weekly strategy sync sessions with engineering leads"] }
        ];

        const hostingMatrix = [
            { threshold: 25, label: "Web Essential", price: 1080, specs: ["Standard Performance", "1 Website Selection", "Unlimited NVMe-SSD Storage", "Unmetered Bandwidth", "Weekly Backup Schemas", "2GB LVE RAM Core Allocation"] },
            { threshold: 50, label: "Web Plus", price: 1800, specs: ["Standard Performance", "5 Distributed Websites", "Unlimited NVMe-SSD Storage", "Unmetered Bandwidth", "Daily Backup Routine Protocols", "cPanel Access Control Dashboards"] },
            { threshold: 75, label: "Web Pro", price: 3240, specs: ["Boosted Processing Engine", "Unlimited Websites Allocation", "Unlimited NVMe-SSD Storage", "Daily Backup Routine Protocols", "4GB High-Tier LVE RAM Allocation", "Python / Node.js Support"] },
            { threshold: 101, label: "Web Ultimate", price: 4320, specs: ["5x Faster Execution Benchmarks", "Unlimited Websites Allocation", "Unlimited NVMe-SSD Storage", "Unmetered Bandwidth", "Daily Backup Routine Protocols", "File Limit: 5,000,000"] }
        ];

        const domainMatrix = [
            { threshold: 12, label: ".xyz Extension", price: 500, specs: ["Instant DNS Allocation", "Free Namespace Privacy Protection", "Full Ownership Lock Control"] },
            { threshold: 25, label: ".info Extension", price: 799, specs: ["Instant DNS Allocation", "Free Namespace Privacy Protection", "Full Ownership Lock Control"] },
            { threshold: 37, label: ".biz Extension", price: 1299, specs: ["Instant DNS Allocation", "Free Namespace Privacy Protection", "Full Ownership Lock Control"] },
            { threshold: 50, label: ".in Extension", price: 1500, specs: ["Regional Targeting Indexing Boost", "Free Namespace Privacy Protection", "Full Ownership Lock Control"] },
            { threshold: 62, label: ".com Extension", price: 2500, specs: ["Global Commercial Branding Priority", "Free Namespace Privacy Protection", "Full Ownership Lock Control"] },
            { threshold: 75, label: ".net Extension", price: 3000, specs: ["Infrastructure Tech Authority Extension", "Free Namespace Privacy Protection", "Full Ownership Lock Control"] },
            { threshold: 87, label: ".org Extension", price: 3000, specs: ["Non-Profit Entity Structural Priority", "Free Namespace Privacy Protection", "Full Ownership Lock Control"] },
            { threshold: 101, label: ".me Extension", price: 3500, specs: ["Personal Portfolio Priority", "Free Namespace Privacy Protection", "Full Ownership Lock Control"] }
        ];

        // Core Elements Fetch Invocations
        const premiumProductCards = document.querySelectorAll('.product-premium-card');
        const itemsLedgerContainer = document.getElementById('cart-nodes-wrapper');
        const summaryTotalValueDisplay = document.getElementById('grand-total-ledger');
        const processOrderFormBtn = document.getElementById('submit-order-btn');
        const navCartTriggerBox = document.getElementById('nav-cart-trigger');
        
        const layoutGridWrapper = document.getElementById('main-layout-wrapper');
        const checkoutSidebarPanel = document.getElementById('checkout-sidebar-panel');
        const fullCheckoutForm = document.getElementById('store-checkout-form');

        function formatRupees(num) {
            return num.toLocaleString('en-IN');
        }

        // Logic framework that continuously extracts content metrics depending on continuous sliding percentages
        function parseContinuousMatrix(currentSliderVal, referenceMatrix, labelNode, priceNode, specContainer, cacheKey) {
            const numericVal = parseInt(currentSliderVal);
            let activeMatch = referenceMatrix[0];
            
            for (let targetTier of referenceMatrix) {
                if (numericVal <= targetTier.threshold) {
                    activeMatch = targetTier;
                    break;
                }
            }

            // Only update specifications inside DOM structure if a true plan jump takes place to avoid visual noise
            if (!currentlyActiveState[cacheKey] || currentlyActiveState[cacheKey].label !== activeMatch.label) {
                specContainer.innerHTML = activeMatch.specs.map(item => `<li><i class="fa-solid fa-circle-check"></i> <span>${item}</span></li>`).join('');
            }

            labelNode.textContent = activeMatch.label;
            priceNode.textContent = formatRupees(activeMatch.price);
            currentlyActiveState[cacheKey] = activeMatch;
        }

        // 1. Web Application Continuous Engine
        const webdevSlider = document.querySelector('.webdev-step-slider');
        const webdevLabel = document.getElementById('webdev-tier-txt');
        const webdevPriceDisplay = document.getElementById('webdev-price-txt');
        const webdevSpecTarget = document.getElementById('webdev-spec-target');
        function syncWebdevContinuous() {
            parseContinuousMatrix(webdevSlider.value, webdevMatrix, webdevLabel, webdevPriceDisplay, webdevSpecTarget, 'webdev');
        }
        webdevSlider.addEventListener('input', syncWebdevContinuous);

        // 2. Graphic Design Continuous Engine
        const graphicSlider = document.querySelector('.graphic-step-slider');
        const graphicLabel = document.getElementById('graphic-tier-txt');
        const graphicPriceDisplay = document.getElementById('graphic-price-txt');
        const graphicSpecTarget = document.getElementById('graphic-spec-target');
        function syncGraphicContinuous() {
            parseContinuousMatrix(graphicSlider.value, graphicMatrix, graphicLabel, graphicPriceDisplay, graphicSpecTarget, 'graphic');
        }
        graphicSlider.addEventListener('input', syncGraphicContinuous);

        // 3. Digital Marketing Continuous Engine
        const marketingSlider = document.querySelector('.marketing-step-slider');
        const marketingLabel = document.getElementById('marketing-tier-txt');
        const marketingPriceDisplay = document.getElementById('marketing-price-txt');
        const marketingSpecTarget = document.getElementById('marketing-spec-target');
        function syncMarketingContinuous() {
            parseContinuousMatrix(marketingSlider.value, marketingMatrix, marketingLabel, marketingPriceDisplay, marketingSpecTarget, 'marketing');
        }
        marketingSlider.addEventListener('input', syncMarketingContinuous);

        // 4. Web Hosting Continuous Engine
        const hostingSlider = document.querySelector('.hosting-step-slider');
        const hostingLabel = document.getElementById('hosting-tier-txt');
        const hostingPriceDisplay = document.getElementById('hosting-price-txt');
        const hostingSpecTarget = document.getElementById('hosting-spec-target');
        function syncHostingContinuous() {
            parseContinuousMatrix(hostingSlider.value, hostingMatrix, hostingLabel, hostingPriceDisplay, hostingSpecTarget, 'hosting');
        }
        hostingSlider.addEventListener('input', syncHostingContinuous);

        // 5. Domain Registration Continuous Engine
        const domainSlider = document.querySelector('.domain-step-slider');
        const domainLabel = document.getElementById('domain-tier-txt');
        const domainPriceDisplay = document.getElementById('domain-price-txt');
        const domainSpecTarget = document.getElementById('domain-spec-target');
        function syncDomainContinuous() {
            parseContinuousMatrix(domainSlider.value, domainMatrix, domainLabel, domainPriceDisplay, domainSpecTarget, 'domain');
        }
        domainSlider.addEventListener('input', syncDomainContinuous);

        // Click event tracker on nav cart
        navCartTriggerBox.addEventListener('click', () => {
            if (checkoutCartItems.length === 0) {
                alert("Your active order selection basket is empty. Add a service to proceed.");
                return;
            }
            fullCheckoutForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
            fullCheckoutForm.style.boxShadow = '0 0 0 4px rgba(59, 130, 246, 0.2)';
            setTimeout(() => { fullCheckoutForm.style.boxShadow = 'none'; }, 1500);
        });

        // Add to Basket Routing Architecture (Instantly reads current live state metrics)
        premiumProductCards.forEach(card => {
            const actionPushBtn = card.querySelector('.action-add-btn');
            actionPushBtn.addEventListener('click', () => {
                const itemId = card.getAttribute('data-id');
                const baseCardName = card.getAttribute('data-name');
                let liveTierMatch = null;

                if (itemId === 'web_development') liveTierMatch = currentlyActiveState['webdev'];
                else if (itemId === 'graphic_design') liveTierMatch = currentlyActiveState['graphic'];
                else if (itemId === 'digital_marketing') liveTierMatch = currentlyActiveState['marketing'];
                else if (itemId === 'web_hosting') liveTierMatch = currentlyActiveState['hosting'];
                else if (itemId === 'domain_registry') liveTierMatch = currentlyActiveState['domain'];

                if (!liveTierMatch) return;

                const processedName = `${baseCardName} (${liveTierMatch.label})`;
                const existingIndex = checkoutCartItems.findIndex(node => node.id === itemId);
                
                if (existingIndex > -1) {
                    checkoutCartItems[existingIndex].name = processedName;
                    checkoutCartItems[existingIndex].price = liveTierMatch.price;
                } else {
                    checkoutCartItems.push({ id: itemId, name: processedName, price: liveTierMatch.price });
                }

                syncClientStoreEcosystem();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });

        function syncClientStoreEcosystem() {
            itemsLedgerContainer.innerHTML = "";
            const dynamicItemCount = checkoutCartItems.length;
            
            if(dynamicItemCount === 0) {
                navCartTriggerBox.classList.remove('has-items');
                checkoutSidebarPanel.classList.remove('visible');
                setTimeout(() => {
                    checkoutSidebarPanel.classList.add('hidden');
                    layoutGridWrapper.classList.remove('has-items');
                }, 400); 
                
                summaryTotalValueDisplay.textContent = "0";
                processOrderFormBtn.disabled = true;
                return;
            }

            navCartTriggerBox.classList.add('has-items');

            if(checkoutSidebarPanel.classList.contains('hidden')) {
                layoutGridWrapper.classList.add('has-items');
                checkoutSidebarPanel.classList.remove('hidden');
                setTimeout(() => { checkoutSidebarPanel.classList.add('visible'); }, 50);
            }

            processOrderFormBtn.disabled = false;
            let currentAggregatedTotal = 0;

            checkoutCartItems.forEach((cartNode, numericPointer) => {
                currentAggregatedTotal += cartNode.price;

                const interactiveRowElement = document.createElement('div');
                interactiveRowElement.className = 'ledger-row';
                interactiveRowElement.innerHTML = `
                    <div class="ledger-row-details">
                        <h4>${cartNode.name}</h4>
                        <span>Rs. ${formatRupees(cartNode.price)}</span>
                    </div>
                    <button type="button" class="ledger-row-delete" onclick="expelCartRow(${numericPointer})" title="Remove item">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                `;
                itemsLedgerContainer.appendChild(interactiveRowElement);
            });

            summaryTotalValueDisplay.textContent = formatRupees(currentAggregatedTotal);
        }

        window.expelCartRow = function(targetPositionIndex) {
            checkoutCartItems.splice(targetPositionIndex, 1);
            syncClientStoreEcosystem();
        };

        // Complete form pipeline handoff processing
        document.getElementById('store-checkout-form').addEventListener('submit', function(event) {
            event.preventDefault();

            if(checkoutCartItems.length === 0) {
                alert("Your active order selection basket is empty.");
                return;
            }

            const buyerNameString = document.getElementById('usr-name').value;
            const buyerEmailString = document.getElementById('usr-email').value;
            const extraClientSpecs = document.getElementById('usr-notes').value || "None provided";
            const currentGrandSumVal = summaryTotalValueDisplay.textContent;

            const targetRecipient = "contact@ayushacharya5.com.np";

            let emailBodyText = `ORDER PROPOSAL - shop.ayushacharya\n`;
            emailBodyText += `-----------------------------------------\n\n`;
            emailBodyText += `CLIENT INFO:\n`;
            emailBodyText += `Name: ${buyerNameString}\n`;
            emailBodyText += `Email: ${buyerEmailString}\n\n`;
            
            emailBodyText += `SELECTED SERVICES:\n`;
            checkoutCartItems.forEach((node, idx) => {
                emailBodyText += `[${idx + 1}] ${node.name} -> Rs. ${formatRupees(node.price)}\n`;
            });
            emailBodyText += `\n`;

            emailBodyText += `TOTAL INVESTMENT: Rs. ${currentGrandSumVal}\n`;
            emailBodyText += `PAYMENT METHOD: FonePay Secure QR\n\n`;

            emailBodyText += `SPECIAL INSTRUCTIONS:\n`;
            emailBodyText += `${extraClientSpecs}\n\n`;
            emailBodyText += `-----------------------------------------\n`;
            emailBodyText += `Sent via shop.ayushacharya platform.`;

            const dynamicSubject = `Order Proposal - ${buyerNameString}`;
            const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

            if (!isMobile) {
                const gmailWebUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${targetRecipient}&su=${encodeURIComponent(dynamicSubject)}&body=${encodeURIComponent(emailBodyText)}`;
                window.open(gmailWebUrl, '_blank');
            } else {
                const nativeMailtoUrl = `mailto:${targetRecipient}?subject=${encodeURIComponent(dynamicSubject)}&body=${encodeURIComponent(emailBodyText)}`;
                window.location.href = nativeMailtoUrl;
            }

            checkoutCartItems = [];
            document.getElementById('store-checkout-form').reset();
            syncClientStoreEcosystem();
        });

        document.getElementById('custom-assistance-link').addEventListener('click', function(event) {
            event.preventDefault();

            const targetRecipient = "contact@ayushacharya5.com.np";
            const dynamicSubject = "Custom Project Inquiry - shop.ayushacharya";
            const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

            if (!isMobile) {
                const gmailWebUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${targetRecipient}&su=${encodeURIComponent(dynamicSubject)}`;
                window.open(gmailWebUrl, '_blank');
            } else {
                const nativeMailtoUrl = `mailto:${targetRecipient}?subject=${encodeURIComponent(dynamicSubject)}`;
                window.location.href = nativeMailtoUrl;
            }
        });

        // Initialize state setups on immediate application boot
        syncWebdevContinuous();
        syncGraphicContinuous();
        syncMarketingContinuous();
        syncHostingContinuous();
        syncDomainContinuous();
    </script>
</body>
</html>
