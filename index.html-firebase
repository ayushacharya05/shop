    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getAuth, signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import { getFirestore, collection, addDoc, query, where, onSnapshot, updateDoc, doc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";
        import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-storage.js";
        import { getAnalytics } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-analytics.js";

        const firebaseConfig = {
            apiKey: "AIzaSyC1HjhcaaoDiOWnE8VubodBA1ZA1d8A_dA",
            authDomain: "shop-ayushacharya.firebaseapp.com",
            projectId: "shop-ayushacharya",
            storageBucket: "shop-ayushacharya.firebasestorage.app",
            messagingSenderId: "768454356269",
            appId: "1:768454356269:web:72f2afb37584f30ba6b7a4",
            measurementId: "G-P1KNKKYCGC"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const storage = getStorage(app);
        const analytics = getAnalytics(app);
        const googleProvider = new GoogleAuthProvider();

        let currentAuthenticatedUser = null;
        let unsubscribeOrders = null;

        document.getElementById('login-trigger-btn').addEventListener('click', loginUserPipeline);
        document.getElementById('dashboard-login-btn').addEventListener('click', loginUserPipeline);

        async function loginUserPipeline() {
            try {
                await signInWithPopup(auth, googleProvider);
            } catch (error) {
                console.error("Authentication Fault:", error);
                alert("Google Sign-In failed: " + error.message);
            }
        }

        window.logoutUserPipeline = async function() {
            try {
                await signOut(auth);
            } catch (error) {
                console.error("Logout error", error);
            }
        };

        onAuthStateChanged(auth, (user) => {
            const navbarDock = document.getElementById('navbar-auth-dock');
            const fallbackView = document.getElementById('auth-fallback-view');
            const authenticatedView = document.getElementById('authenticated-portal-view');

            if (user) {
                currentAuthenticatedUser = user;
                document.getElementById('usr-name').value = user.displayName || "";
                document.getElementById('usr-email').value = user.email || "";

                navbarDock.innerHTML = `
                    <div class="user-profile-badge">
                        <img src="${user.photoURL || 'https://via.placeholder.com/32'}" alt="Avatar">
                        <span>${user.displayName || 'Client'}</span>
                        <button class="logout-trigger" onclick="logoutUserPipeline()" title="Sign Out">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </button>
                    </div>
                `;
                
                fallbackView.classList.add('hidden');
                authenticatedView.classList.remove('hidden');
                listenToLiveCustomerOrders(user.uid);
            } else {
                currentAuthenticatedUser = null;
                if(unsubscribeOrders) { unsubscribeOrders(); unsubscribeOrders = null; }

                navbarDock.innerHTML = `
                    <button class="google-login-btn" id="login-trigger-btn-retry"><i class="fa-brands fa-google"></i> Sign In</button>
                `;
                document.getElementById('login-trigger-btn-retry').addEventListener('click', loginUserPipeline);
                
                fallbackView.classList.remove('hidden');
                authenticatedView.classList.add('hidden');
            }
        });

        function listenToLiveCustomerOrders(uid) {
            const ordersQuery = query(collection(db, "orders"), where("userId", "==", uid));
            
            unsubscribeOrders = onSnapshot(ordersQuery, (snapshot) => {
                const ordersList = [];
                snapshot.forEach((doc) => {
                    ordersList.push({ docId: doc.id, ...doc.data() });
                });
                ordersList.sort((a,b) => (b.timestamp || 0) - (a.timestamp || 0));
                renderCustomerOrdersDashboard(ordersList);
            }, (error) => {
                console.error("Firestore loading failure:", error);
            });
        }

        function renderCustomerOrdersDashboard(orders) {
            const renderDock = document.getElementById('orders-render-dock');
            renderDock.innerHTML = "";

            if (orders.length === 0) {
                renderDock.innerHTML = `<p style="text-align:center; color:var(--text-muted); padding:2rem; font-weight:600;">No verified data orders inside your account logs.</p>`;
                return;
            }

            orders.forEach((order) => {
                const step = order.statusStep || 1;
                const progressWidth = step === 1 ? 0 : step === 2 ? 33.33 : step === 3 ? 66.66 : 100;
                
                let fileHubMarkup = "";
                if (order.downloadUrl) {
                    fileHubMarkup = `
                        <div class="asset-delivery-hub">
                            <div class="delivery-instructions">
                                <h5><i class="fa-solid fa-box-open" style="color:var(--brand-success);"></i> Project Deliverables Ready!</h5>
                                <p>Your production files are ready. Download the output below.</p>
                            </div>
                            <a href="${order.downloadUrl}" target="_blank" class="action-download-btn">
                                <i class="fa-solid fa-cloud-arrow-down"></i> Download Package (.zip)
                            </a>
                        </div>
                    `;
                } else {
                    fileHubMarkup = `
                        <div class="asset-delivery-hub">
                            <div class="delivery-instructions">
                                <h5><i class="fa-solid fa-cloud-arrow-up" style="color:var(--brand-primary);"></i> Project Asset Ingestion</h5>
                                <p>Upload blueprints, copy assets, or visual guidelines requirements.</p>
                            </div>
                            <div>
                                <label class="action-upload-btn-label">
                                    <input type="file" class="upload-input-trigger" data-id="${order.docId}">
                                    <i class="fa-solid fa-paperclip"></i> ${order.clientFileName ? order.clientFileName : "Attach Spec Sheet"}
                                </label>
                                <div id="upload-status-${order.docId}" class="loading-text"></div>
                            </div>
                        </div>
                    `;
                }

                const cardNode = document.createElement('div');
                cardNode.className = 'order-card';
                cardNode.innerHTML = `
                    <div class="order-meta-bar">
                        <div class="meta-group"><span class="meta-label">Order Ref ID</span><span class="meta-value">${order.docId.substring(0,8).toUpperCase()}</span></div>
                        <div class="meta-group"><span class="meta-label">Date Dispatched</span><span class="meta-value">${order.dateString}</span></div>
                        <div class="meta-group"><span class="meta-label">Total Volume</span><span class="meta-value">${order.investment}</span></div>
                        <div class="meta-group"><span class="meta-label">Verification Gate</span><span class="meta-value" style="color:var(--brand-success);"><i class="fa-solid fa-shield-halved"></i> Verified</span></div>
                    </div>
                    <div class="order-contents">
                        <div class="order-item-row">${order.itemsSummary}</div>
                        <div class="tracking-pipeline">
                            <div class="pipeline-fill" style="width: ${progressWidth}%;"></div>
                            <div class="pipeline-node ${step >= 1 ? (step == 1 ? 'current' : 'completed') : ''}"><div class="node-dot">${step > 1 ? '✓' : '1'}</div><div class="node-title">Requested</div></div>
                            <div class="pipeline-node ${step >= 2 ? (step == 2 ? 'current' : 'completed') : ''}"><div class="node-dot">${step > 2 ? '✓' : '2'}</div><div class="node-title">Production</div></div>
                            <div class="pipeline-node ${step >= 3 ? (step == 3 ? 'current' : 'completed') : ''}"><div class="node-dot">${step > 3 ? '✓' : '3'}</div><div class="node-title">QA Check</div></div>
                            <div class="pipeline-node ${step >= 4 ? (step == 4 ? 'current' : 'completed') : ''}"><div class="node-dot">${step > 4 ? '✓' : '4'}</div><div class="node-title">Deployed</div></div>
                        </div>
                    </div>
                    ${fileHubMarkup}
                `;
                renderDock.appendChild(cardNode);
            });

            document.querySelectorAll('.upload-input-trigger').forEach(input => {
                input.addEventListener('change', executeClientFileStorageUpload);
            });
        }

        async function executeClientFileStorageUpload(e) {
            const selectedFile = e.target.files[0];
            const orderDocId = e.target.getAttribute('data-id');
            if(!selectedFile || !orderDocId) return;

            const trackingIndicator = document.getElementById(`upload-status-${orderDocId}`);
            trackingIndicator.textContent = "Uploading assets securely...";

            try {
                const fileRefPath = ref(storage, `client_briefs/${orderDocId}/${selectedFile.name}`);
                await uploadBytes(fileRefPath, selectedFile);
                const fileDownloadUrl = await getDownloadURL(fileRefPath);

                const documentRef = doc(db, "orders", orderDocId);
                await updateDoc(documentRef, {
                    clientFileUrl: fileDownloadUrl,
                    clientFileName: selectedFile.name
                });

                trackingIndicator.textContent = "Upload complete!";
            } catch (error) {
                console.error("Storage upload faulted:", error);
                trackingIndicator.textContent = "Upload error occurred.";
                alert("Error archiving file attachment setup: " + error.message);
            }
        }

        document.getElementById('store-checkout-form').addEventListener('submit', async function(event) {
            event.preventDefault();

            if(!currentAuthenticatedUser) {
                alert("Please authenticate via Google using the account portal below before locking in your checkout order profile.");
                document.getElementById('customer-portal-anchor').scrollIntoView({ behavior: 'smooth' });
                return;
            }

            const buyerNameString = document.getElementById('usr-name').value;
            const buyerEmailString = document.getElementById('usr-email').value;
            const extraClientSpecs = document.getElementById('usr-notes').value || "None";
            const currentGrandSumVal = document.getElementById('grand-total-ledger').textContent;
            const collectedNames = checkoutCartItems.map(n => n.name).join(', ');

            try {
                processOrderFormBtn.disabled = true;
                processOrderFormBtn.textContent = "Saving to Database...";

                await addDoc(collection(db, "orders"), {
                    userId: currentAuthenticatedUser.uid,
                    userEmail: currentAuthenticatedUser.email,
                    clientName: buyerNameString,
                    itemsSummary: collectedNames,
                    investment: "Rs. " + currentGrandSumVal,
                    notes: extraClientSpecs,
                    statusStep: 1, 
                    downloadUrl: null, 
                    clientFileName: null,
                    clientFileUrl: null,
                    dateString: new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }),
                    timestamp: Date.now()
                });

                alert("Order recorded successfully in the database! Opening client email handoff portal.");
                triggerClientEmailHandoff(buyerNameString, buyerEmailString, currentGrandSumVal, extraClientSpecs);

                checkoutCartItems = [];
                document.getElementById('store-checkout-form').reset();
                syncClientStoreEcosystem();
            } catch (error) {
                console.error("Order writing faulted:", error);
                alert("Error updating order structure records: " + error.message);
            } finally {
                processOrderFormBtn.disabled = false;
                processOrderFormBtn.textContent = "Place Order Request";
            }
        });

        function triggerClientEmailHandoff(name, email, total, notes) {
            const targetRecipient = "contact@ayushacharya5.com.np";
            let emailBodyText = `ORDER PROPOSAL - shop.ayushacharya\n=========================================\n`;
            emailBodyText += `Client Profile: ${name} (${email})\n`;
            emailBodyText += `Grand Invoice Investment: Rs. ${total}\n`;
            emailBodyText += `Instructions: ${notes}\n=========================================\n`;
            
            const dynamicSubject = `Order Proposal - ${name}`;
            const nativeMailtoUrl = `mailto:${targetRecipient}?subject=${encodeURIComponent(dynamicSubject)}&body=${encodeURIComponent(emailBodyText)}`;
            window.location.href = nativeMailtoUrl;
        }
    </script>

    <script>
        let checkoutCartItems = [];
        let currentlyActiveState = {};
        
        const webdevMatrix = [
            { threshold: 50, label: "Essential Tier", price: 5000, specs: ["Responsive UI Blueprint layouts", "Basic landing elements", "Speed-optimized page templates"] },
            { threshold: 101, label: "Ultimate Tier", price: 85000, specs: ["Fullstack application infrastructure builds", "Secure relational database frameworks", "24/7 Deployment assistance guarantees"] }
        ];

        const graphicMatrix = [
            { threshold: 50, label: "Essential Tier", price: 1000, specs: ["1 High-resolution Vector profile template", "Export elements in multiple transparent formats"] },
            { threshold: 101, label: "Ultimate Tier", price: 25000, specs: ["Complete production corporate brand asset system books", "Bespoke custom product UI/UX kits layouts"] }
        ];

        const premiumProductCards = document.querySelectorAll('.product-premium-card');
        const itemsLedgerContainer = document.getElementById('cart-nodes-wrapper');
        const summaryTotalValueDisplay = document.getElementById('grand-total-ledger');
        const processOrderFormBtn = document.getElementById('submit-order-btn');
        const navCartTriggerBox = document.getElementById('nav-cart-trigger');
        const layoutGridWrapper = document.getElementById('main-layout-wrapper');
        const checkoutSidebarPanel = document.getElementById('checkout-sidebar-panel');

        function parseContinuousMatrix(currentSliderVal, referenceMatrix, labelNode, priceNode, specContainer, cacheKey) {
            const numericVal = parseInt(currentSliderVal);
            let activeMatch = referenceMatrix[0];
            for (let tier of referenceMatrix) { if (numericVal <= tier.threshold) { activeMatch = tier; break; } }
            if (!currentlyActiveState[cacheKey] || currentlyActiveState[cacheKey].label !== activeMatch.label) {
                specContainer.innerHTML = activeMatch.specs.map(item => `<li><i class="fa-solid fa-circle-check"></i> <span>${item}</span></li>`).join('');
            }
            labelNode.textContent = activeMatch.label; priceNode.textContent = activeMatch.price.toLocaleString('en-IN');
            currentlyActiveState[cacheKey] = activeMatch;
        }

        const wdS = document.querySelector('.webdev-step-slider');
        function syncWd(){ parseContinuousMatrix(wdS.value, webdevMatrix, document.getElementById('webdev-tier-txt'), document.getElementById('webdev-price-txt'), document.getElementById('webdev-spec-target'), 'webdev'); }
        wdS.addEventListener('input', syncWd); syncWd();

        const gdS = document.querySelector('.graphic-step-slider');
        function syncGd(){ parseContinuousMatrix(gdS.value, graphicMatrix, document.getElementById('graphic-tier-txt'), document.getElementById('graphic-price-txt'), document.getElementById('graphic-spec-target'), 'graphic'); }
        gdS.addEventListener('input', syncGd); syncGd();

        premiumProductCards.forEach(card => {
            card.querySelector('.action-add-btn').addEventListener('click', () => {
                const itemId = card.getAttribute('data-id');
                const baseCardName = card.getAttribute('data-name');
                let liveTierMatch = (itemId === 'web_development') ? currentlyActiveState['webdev'] : currentlyActiveState['graphic'];
                
                const processedName = `${baseCardName} (${liveTierMatch.label})`;
                const existingIndex = checkoutCartItems.findIndex(node => node.id === itemId);
                if (existingIndex > -1) { checkoutCartItems[existingIndex].name = processedName; checkoutCartItems[existingIndex].price = liveTierMatch.price; }
                else { checkoutCartItems.push({ id: itemId, name: processedName, price: liveTierMatch.price }); }
                syncClientStoreEcosystem();
            });
        });

        function syncClientStoreEcosystem() {
            itemsLedgerContainer.innerHTML = "";
            if(checkoutCartItems.length === 0) {
                navCartTriggerBox.classList.remove('has-items'); checkoutSidebarPanel.classList.remove('visible');
                checkoutSidebarPanel.classList.add('hidden'); layoutGridWrapper.classList.remove('has-items');
                processOrderFormBtn.disabled = true; return;
            }
            navCartTriggerBox.classList.add('has-items'); layoutGridWrapper.classList.add('has-items');
            checkoutSidebarPanel.classList.remove('hidden'); setTimeout(() => { checkoutSidebarPanel.classList.add('visible'); }, 50);
            processOrderFormBtn.disabled = false;
            let currentAggregatedTotal = 0;
            checkoutCartItems.forEach((cartNode, idx) => {
                currentAggregatedTotal += cartNode.price;
                const row = document.createElement('div'); row.className = 'ledger-row';
                row.innerHTML = `<div class="ledger-row-details"><h4>${cartNode.name}</h4><span>Rs. ${cartNode.price.toLocaleString('en-IN')}</span></div>
                                 <button type="button" class="ledger-row-delete" onclick="expelCartRow(${idx})"><i class="fa-solid fa-trash-can"></i></button>`;
                itemsLedgerContainer.appendChild(row);
            });
            summaryTotalValueDisplay.textContent = currentAggregatedTotal.toLocaleString('en-IN');
        }

        window.expelCartRow = function(targetPositionIndex) { checkoutCartItems.splice(targetPositionIndex, 1); syncClientStoreEcosystem(); };
    </script>
</body>
</html>
